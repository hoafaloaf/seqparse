#!/bin/bash
# Local equivalent of .github/workflows/ci.yml (needs ruff and mypy installed).
set -u

status=0
ruff check seqparse benchmarks || status=1
ruff format --check seqparse benchmarks || status=1
mypy || status=1
python -m coverage run -m pytest -q || status=1
python -m coverage report --include="seqparse/*" --omit="seqparse/test/*"

exit ${status}
